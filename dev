#!/usr/bin/env sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tools_dir="${repo_dir}/.tools"
pixi_home="${tools_dir}/pixi"
pixi_bin="${pixi_home}/bin/pixi"
installer_url="${PIXI_INSTALLER_URL:-https://pixi.sh/install.sh}"

if [ -x "$pixi_bin" ]; then
    :
elif command -v pixi >/dev/null 2>&1; then
    pixi_bin=$(command -v pixi)
else
    mkdir -p "$pixi_home/bin"
    installer="${TMPDIR:-/tmp}/pixi-install.$$"
    trap 'rm -f "$installer"' EXIT HUP INT TERM
    if command -v curl >/dev/null 2>&1; then
        curl -LsSf "$installer_url" -o "$installer"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$installer" "$installer_url"
    else
        echo "Install curl or wget so this script can bootstrap Pixi." >&2
        exit 1
    fi
    env PIXI_HOME="$pixi_home" PIXI_BIN_DIR="${pixi_home}/bin" PIXI_NO_PATH_UPDATE=1 sh "$installer"
fi

export PIXI_HOME="${PIXI_HOME:-$pixi_home}"
export PIXI_CACHE_DIR="${PIXI_CACHE_DIR:-${tools_dir}/pixi-cache}"

cd "$repo_dir"
exec "$pixi_bin" "$@"
