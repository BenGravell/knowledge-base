[importlinter]
root_package = knowledge_base

[importlinter:contract:workflow_modules_do_not_import_script_commands]
name = Durable workflow modules do not import script commands
type = forbidden
source_modules =
    knowledge_base.tree
    knowledge_base.publishing
    knowledge_base.prefill
    knowledge_base.embeddings
    knowledge_base.components
forbidden_modules =
    knowledge_base.scripts

[importlinter:contract:metadata_dependencies]
name = Metadata and arXiv identifiers stay independent of configuration and workflows
type = forbidden
source_modules =
    knowledge_base.metadata
    knowledge_base.utils.arxiv_ids
forbidden_modules =
    knowledge_base.config
    knowledge_base.catalog
    knowledge_base.utils.arxiv_utils
    knowledge_base.prefill
